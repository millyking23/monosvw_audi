# Email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Comma-separated recipient list. Example:
# NOTIFY_EMAIL_TO=one@example.com,two@example.com,three@example.com
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Existing Meta WhatsApp Cloud API configuration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=

# Reserved for stronger bot protection when enabled
TURNSTILE_SECRET_KEY=
